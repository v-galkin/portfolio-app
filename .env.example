# Production settings for docker-compose.
# Copy to .env (git-ignored) next to docker-compose.yml on the server and fill in real values.
# For local development of the backend, see backend/.env.example instead.

# Admin login for /admin (required, non-empty)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database password, used by both portfolio-db and portfolio-backend (required, non-empty).
# Postgres only applies it when the data volume is first created. To change it on an
# existing database, run ALTER USER first; see BUGS.md #8.
POSTGRES_PASSWORD=

# Comma-separated origins allowed to call the API, e.g. https://your-domain.com
CORS_ALLOWED_ORIGINS=
