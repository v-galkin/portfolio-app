# Local development settings for the backend.
# Copy this file to backend/.env (git-ignored) and change the values.
# Spring reads backend/.env when you run the app from the backend/ folder.

# Required: the app won't start without these
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: these defaults already match the local dev database
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/portfolio
# SPRING_DATASOURCE_USERNAME=portfolio_user
# SPRING_DATASOURCE_PASSWORD=portfolio_pass
# CORS_ALLOWED_ORIGINS=http://localhost:5173
